<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abdullah Abbas IPTV</title>
    <!-- استدعاء مكتبة Tailwind CSS للتصميم -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- خط تجوال لدعم اللغة العربية بشكل أنيق -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap');
        body { font-family: 'Tajawal', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <!-- شريط التنقل (Navbar) -->
    <nav class="bg-slate-900 text-white p-4 shadow-lg">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-bold tracking-wider">Abdullah Abbas IPTV</h1>
            <ul class="flex space-x-6 space-x-reverse">
                <li><a href="#" class="hover:text-blue-400 transition">الرئيسية</a></li>
                <li><a href="#features" class="hover:text-blue-400 transition">المميزات</a></li>
                <li><a href="https://github.com/abdullahalnasser2014/Abdullah-Abbas-IPTV" target="_blank" class="hover:text-blue-400 transition">GitHub</a></li>
            </ul>
        </div>
    </nav>

    <!-- القسم الرئيسي (Hero Section) -->
    <header class="bg-gradient-to-r from-slate-800 to-slate-900 text-white text-center py-24 px-4">
        <h2 class="text-4xl md:text-6xl font-bold mb-6">تجربة المشاهدة الأفضل</h2>
        <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto text-gray-300">
            مكتبة متكاملة من القنوات والمحتوى الترفيهي بجودة عالية، مع استقرار تام لضمان مشاهدة ممتعة بدون انقطاع.
        </p>
        <a href="https://github.com/abdullahalnasser2014/Abdullah-Abbas-IPTV/archive/refs/heads/main.zip" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-8 rounded-full shadow-lg transition duration-300 inline-block">
            تحميل قائمة القنوات
        </a>
    </header>

    <!-- قسم المميزات (Features) -->
    <section id="features" class="py-20 container mx-auto text-center px-4">
        <h3 class="text-3xl font-bold mb-12 text-slate-800">لماذا تختار هذه الخدمة؟</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- ميزة 1 -->
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
                <div class="text-blue-600 text-4xl mb-4">📺</div>
                <h4 class="text-xl font-bold mb-3">جودة عالية</h4>
                <p class="text-gray-600">بث فائق الدقة يدعم جودات متعددة لتناسب سرعة اتصالك.</p>
            </div>
            <!-- ميزة 2 -->
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
                <div class="text-blue-600 text-4xl mb-4">⚡</div>
                <h4 class="text-xl font-bold mb-3">استقرار تام</h4>
                <p class="text-gray-600">سيرفرات قوية وموثوقة لضمان المشاهدة بدون أي تقطيع.</p>
            </div>
            <!-- ميزة 3 -->
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
                <div class="text-blue-600 text-4xl mb-4">🔄</div>
                <h4 class="text-xl font-bold mb-3">تحديث مستمر</h4>
                <p class="text-gray-600">إضافة قنوات ومحتوى جديد بشكل دوري لضمان تغطية شاملة.</p>
            </div>
        </div>
    </section>

    <!-- التذييل (Footer) -->
    <footer class="bg-slate-900 text-gray-400 text-center py-6 mt-10">
        <p>جميع الحقوق محفوظة &copy; 2026 - مشروع Abdullah-Abbas</p>
    </footer>

</body>
</html>
